indego_stations <- read_csv("Data/indego-stations-2026-07-15.csv"
)
indego_joined <- readRDS("Data/indego_joined")
stations_with_coords <- indego_joined |> group_by(start_station,start_lat,start_lon,start.Station_Name) |> count() |> filter(is.na(start_lon)!=T)
#How does it flow by hour?
indego_flow_weekdays<-indego_joined |> filter(day_of_week %notin% c("Saturday", "Sunday"))|> mutate(hour = hour(start_time)) |>
group_by(start_station,hour)|> count(name="start_n") |> arrange(desc(start_n)) |>
full_join(indego_joined |> mutate(hour = hour(end_time)) |>
group_by(end_station,hour)|>
count(name="end_n"),join_by(start_station==end_station,hour)) |> left_join(stations_with_coords, join_by(start_station)) |>  mutate(start_n = ifelse(is.na(start_n),0,start_n),end_n = ifelse(is.na(end_n),0,end_n),flow = end_n-start_n) |>
arrange(start_station,desc(flow)) |> ungroup()
indego_flow_weekend<-indego_joined |> filter(day_of_week %in% c("Saturday", "Sunday"))|> mutate(hour = hour(start_time)) |>
group_by(start_station,hour)|> count(name="start_n") |> arrange(desc(start_n)) |>
full_join(indego_joined |> mutate(hour = hour(end_time)) |>
group_by(end_station,hour)|>
count(name="end_n"),join_by(start_station==end_station,hour)) |> left_join(stations_with_coords, join_by(start_station)) |>  mutate(start_n = ifelse(is.na(start_n),0,start_n),end_n = ifelse(is.na(end_n),0,end_n),flow = end_n-start_n) |>
arrange(start_station,desc(flow)) |> ungroup()
saveRDS(indego_flow_weekdays,"Data/indego_flow_weekdays")
saveRDS(indego_flow_weekend,"Data/indego_flow_weekend")
