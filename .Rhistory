library(gridExtra)
library(ggrepel)
indego_flow <-readRDS("Data/indego_flow_weekdays")
#morning
morning<-indego_flow |> filter(hour <=10 & 5 <= hour) |>
group_by(start.Station_Name,start_lat,start_lon) |> summarise(average_flow = mean(flow,na.rm=T)) |> ungroup() |>
ggplot(aes(x=start_lon,y=start_lat,color = average_flow))+geom_point()+scale_color_gradient2(low = "red", high = "blue")+
labs(x="Longitude",y="Latitude",title="Morning",color="flow")
#mid-day
mid_day<-indego_flow |> filter(hour <=15 & 11 <= hour) |>
group_by(start.Station_Name,start_lat,start_lon) |> summarise(average_flow = mean(flow,na.rm=T)) |> ungroup() |>
ggplot(aes(x=start_lon,y=start_lat,color = average_flow))+geom_point()+scale_color_gradient2(low = "red", high = "blue")+
labs(x="Longitude",y="Latitude",title="Mid-day",color="flow")
# evening
evening<-indego_flow |> filter(hour <=19 & 16 <= hour) |>
group_by(start.Station_Name,start_lat,start_lon) |> summarise(average_flow = mean(flow,na.rm=T)) |> ungroup() |>
ggplot(aes(x=start_lon,y=start_lat,color = average_flow))+geom_point()+scale_color_gradient2(low = "red", high = "blue")+
labs(x="Longitude",y="Latitude",title="Evening",color="flow")
#night
night<-indego_flow |> filter((hour <=24 & 20 <= hour)|(hour <=9 & 0 <= hour)) |> ungroup() |>
group_by(start.Station_Name,start_lat,start_lon) |> summarise(average_flow = mean(flow,na.rm=T)) |>
ggplot(aes(x=start_lon,y=start_lat,color = average_flow))+geom_point()+scale_color_gradient2(low = "red", high = "blue")+
labs(x="Longitude",y="Latitude",title="Night",color="flow")
#Add labels
morning_label <- morning+geom_label_repel(aes(
label=if_else((average_flow >= max(average_flow)-sd(average_flow[average_flow>0]))|(average_flow <= min(average_flow)+sd(average_flow[average_flow<0])),start.Station_Name,NA)
),
force = 175, size=1.6,arrow=arrow(length=unit(.02,"npc")),na.rm=T,color='black',alpha=0.6)
mid_day_label <- mid_day+geom_label_repel(aes(
label=if_else((average_flow >= max(average_flow)-7*sd(average_flow[average_flow>0]))|(average_flow <= min(average_flow)+1.5*sd(average_flow[average_flow<0])),start.Station_Name,NA)
),
force = 175, size=1.6,arrow=arrow(length=unit(.02,"npc")),na.rm=T,color='black',alpha=0.6)
evening_label <- evening+geom_label_repel(aes(
label=if_else((average_flow >= max(average_flow)-7*sd(average_flow[average_flow>0]))|(average_flow <= min(average_flow)+1.5*sd(average_flow[average_flow<0])),start.Station_Name,NA)
),
force = 175, size=1.6,arrow=arrow(length=unit(.02,"npc")),na.rm=T,color='black',alpha=0.6)
night_label <- night+geom_label_repel(aes(
label=if_else((average_flow >= max(average_flow)-2*sd(average_flow[average_flow>0]))|(average_flow <= min(average_flow)+1.5*sd(average_flow[average_flow<0])),start.Station_Name,NA)
),
force = 150, size=1.6,arrow=arrow(length=unit(.02,"npc")),na.rm=T,color='black',alpha=0.6)
grid.arrange(morning,mid_day,evening,night)
grid.arrange(morning_label,mid_day_label,evening_label,night_label)
